# ChessPulse Environment Configuration (.env.example)
# Copy this file to .env for local development. Never commit real secrets to version control.

# Canonical Application Base URL (Used for canonical redirects, robots.txt, and sitemap.xml)
APP_URL="http://localhost:3000"

# Express Server Port
PORT=3000

# Optional Admin Token for protected /api/analytics/summary endpoint
ADMIN_TOKEN=""
